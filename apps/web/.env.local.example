# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project values
# 
# To get these values:
# 1. Go to https://console.firebase.google.com
# 2. Create a project (or select existing)
# 3. Click the gear icon → Project Settings
# 4. Scroll to "Your apps" → Add app → Web
# 5. Copy the config values below

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# IMPORTANT: Enable Email Link (passwordless) sign-in in Firebase Console:
# Authentication → Sign-in method → Email/Password → Enable "Email link (passwordless sign-in)"
